APP_NAME=ReciclaB2B
APP_ENV=production
APP_KEY=
# false: con true, cualquier error muestra trazas de código y rutas del servidor.
APP_DEBUG=false
APP_URL=https://tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
# Contraseña fuerte propia de este entorno, no reutilices la de desarrollo.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Sin esto, las cookies de sesión se enviarían igual por HTTP (no solo HTTPS).
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Detrás de Caddy en el mismo compose.prod.yaml, todo el tráfico ya pasa por
# ese proxy (no llega directo a laravel.test desde fuera) — '*' es seguro aquí.
# Si en algún momento este contenedor quedara accesible sin pasar por Caddy,
# restringe esto a la IP/red real del proxy en vez de '*'.
TRUSTED_PROXIES=*

# Dominio que sirve Caddy (docker/caddy/Caddyfile) — pide el certificado HTTPS
# automáticamente a Let's Encrypt la primera vez que arranca, usando este valor.
APP_DOMAIN=tudominio.com

# Genera credenciales propias de producción con:
#   docker compose -f compose.prod.yaml exec laravel.test php artisan reverb:install
# no reutilices las de desarrollo.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="tudominio.com"
REVERB_PORT=8080
REVERB_SCHEME=https
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
# OJO: el navegador conecta al puerto público de Caddy (443), no al 8080
# interno — Caddy es quien reenvía /app/* a reverb:8080 por dentro de la red
# de Docker. Si aquí pones 8080, el chat/pedidos en tiempo real dejan de
# funcionar en producción porque ese puerto no está expuesto al exterior.
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database

# Brevo por API HTTPS, no SMTP: muchos hostings (Railway incluido) bloquean
# el puerto SMTP saliente, así que MAIL_HOST/PORT no sirven en producción.
MAIL_MAILER=brevo
MAIL_BREVO_KEY=
MAIL_FROM_ADDRESS="notificaciones@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# Vacío = Sentry desactivado sin más (no falla, simplemente no envía nada).
# Rellena con el DSN del proyecto en sentry.io cuando lo tengas.
SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
