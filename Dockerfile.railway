# Build de producción para Railway (dos servicios comparten esta misma imagen:
# "web" con el CMD por defecto, "reverb" sobreescribiendo el start command a
# `php artisan reverb:start --host=0.0.0.0 --port=$PORT`).

FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --ignore-platform-reqs --no-interaction
COPY . .
RUN composer install --no-dev --no-interaction --ignore-platform-reqs --optimize-autoloader

FROM node:20-alpine AS frontend
WORKDIR /app
# Vite incrusta estas variables en el JS compilado en tiempo de build, no de
# arranque — Railway las inyecta como build args si coinciden con el nombre
# de una variable del servicio.
ARG VITE_APP_NAME
ARG VITE_REVERB_APP_KEY
ARG VITE_REVERB_HOST
ARG VITE_REVERB_PORT
ARG VITE_REVERB_SCHEME
ENV VITE_APP_NAME=$VITE_APP_NAME \
    VITE_REVERB_APP_KEY=$VITE_REVERB_APP_KEY \
    VITE_REVERB_HOST=$VITE_REVERB_HOST \
    VITE_REVERB_PORT=$VITE_REVERB_PORT \
    VITE_REVERB_SCHEME=$VITE_REVERB_SCHEME
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
COPY --from=vendor /app/vendor ./vendor
RUN npm run build

FROM php:8.5-cli-alpine
RUN apk add --no-cache --virtual .build-deps $PHPIZE_DEPS icu-dev oniguruma-dev libzip-dev libpng-dev freetype-dev libjpeg-turbo-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo pdo_mysql mbstring bcmath intl zip gd pcntl \
    && apk del .build-deps \
    && apk add --no-cache icu oniguruma libzip libpng freetype libjpeg-turbo

WORKDIR /var/www/html
COPY --from=vendor /app .
COPY --from=frontend /app/public/build ./public/build

RUN chmod -R 775 storage bootstrap/cache

EXPOSE 8080
CMD sh -c "php artisan migrate --force && php artisan config:cache && php artisan route:cache && php artisan serve --host=0.0.0.0 --port=${PORT:-8080}"
